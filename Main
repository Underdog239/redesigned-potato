-- LocalScript in StarterPlayerScripts

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

if _G.ReqiumZCloneController and playerGui:FindFirstChild("ReqiumZ v1") then
    return
end
_G.ReqiumZCloneController = true

local SETTINGS = {
    speedOne = 40,
    speedTwo = 80,
    gravity = 196.2,
    moveDistance = 8,
    maxJoystickRadius = 55,
}

local state = {
    clone = nil,
    keyboardDir = Vector3.zero,
    touchDir = Vector3.zero,
    activeTouch = nil,
    enabled = true,
    speedMode = 1,
    infiniteJump = false,
    originalGravity = workspace.Gravity,
}

local function destroyIfExists(instance)
    if instance and instance.Parent then
        instance:Destroy()
    end
end

local function getMoveDirection()
    return state.touchDir + state.keyboardDir
end

local function getActiveSpeed()
    if state.speedMode == 2 then
        return SETTINGS.speedTwo
    end
    return SETTINGS.speedOne
end

local function getCharacterRoot(character)
    if not character then
        return nil
    end
    return character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
end

local function buildClone()
    if not state.enabled then
        return
    end

    local character = player.Character
    if not character then
        return
    end

    local root = getCharacterRoot(character)
    if not root then
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return
    end

    if state.clone and state.clone.Parent then
        state.clone:Destroy()
    end

    local wasArchivable = character.Archivable
    character.Archivable = true
    local cloneSuccess, clone = pcall(function()
        return character:Clone()
    end)
    character.Archivable = wasArchivable
    if not cloneSuccess or not clone then
        return
    end
    clone.Name = "ReqiumZ_Clone"

    for _, descendant in ipairs(clone:GetDescendants()) do
        if descendant:IsA("Script") or descendant:IsA("LocalScript") or descendant:IsA("ModuleScript") then
            descendant:Destroy()
        elseif descendant:IsA("BasePart") then
            descendant.Anchored = false
            descendant.CanCollide = false
            descendant.Massless = true
            descendant.Transparency = math.max(descendant.Transparency, 0.2)
        end
    end

    local cloneHumanoid = clone:FindFirstChildOfClass("Humanoid")
    if cloneHumanoid then
        cloneHumanoid.WalkSpeed = getActiveSpeed()
        cloneHumanoid.JumpPower = 0
        cloneHumanoid.JumpHeight = 0
        cloneHumanoid.AutoRotate = true
        cloneHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    end

    clone:PivotTo(root.CFrame * CFrame.new(4, 0, 0))
    clone.Parent = workspace
    state.clone = clone
end

local function removeClone()
    if state.clone and state.clone.Parent then
        state.clone:Destroy()
    end
    state.clone = nil
end

local function setGravity(value)
    local gravity = tonumber(value)
    if not gravity then
        return false
    end

    SETTINGS.gravity = math.clamp(gravity, 0, 500)
    workspace.Gravity = SETTINGS.gravity
    return true
end

local function applyActiveSpeed()
    if state.clone then
        local humanoid = state.clone:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = getActiveSpeed()
        end
    end
end

local existingGui = playerGui:FindFirstChild("ReqiumZ v1")
if existingGui then
    destroyIfExists(existingGui)
end

