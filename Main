local function makeButton(name, text, position)
    local button = Instance.new("TextButton")
    button.Name = name
    button.Text = text
    button.Size = UDim2.new(0, 137, 0, 28)
    button.Position = position
    button.BackgroundColor3 = Color3.fromRGB(38, 43, 54)
    button.TextColor3 = Color3.fromRGB(235, 240, 250)
    button.Font = Enum.Font.GothamMedium
    button.TextSize = 11
    button.AutoButtonColor = false
    button.BorderSizePixel = 0
    button.Parent = panel
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 7)
    return button
end

local function addHoverAnimation(button, normalColor, hoverColor)
    button.MouseEnter:Connect(function()
        TweenService:Create(button, FAST_TWEEN, {BackgroundColor3 = hoverColor}):Play()
    end)

    button.MouseLeave:Connect(function()
        TweenService:Create(button, FAST_TWEEN, {BackgroundColor3 = normalColor}):Play()
    end)
end

addHoverAnimation(activateButton, Color3.fromRGB(71, 166, 255), Color3.fromRGB(95, 183, 255))
addHoverAnimation(minimizeButton, Color3.fromRGB(38, 43, 54), Color3.fromRGB(58, 66, 82))
addHoverAnimation(closeButton, Color3.fromRGB(38, 43, 54), Color3.fromRGB(180, 70, 80))
addHoverAnimation(openButton, Color3.fromRGB(38, 43, 54), Color3.fromRGB(58, 66, 82))

local speedOneButton = makeButton("SpeedOne", "Speed 1: 40", UDim2.new(0, 12, 0, 62))
local speedTwoButton = makeButton("SpeedTwo", "Speed 2: 80", UDim2.new(0, 171, 0, 62))
local gravityButton = makeButton("Gravity", "Gravity: 196.2", UDim2.new(0, 12, 0, 126))
local infiniteJumpButton = makeButton("InfJump", "InfJump: OFF", UDim2.new(0, 171, 0, 126))

addHoverAnimation(speedOneButton, Color3.fromRGB(38, 43, 54), Color3.fromRGB(58, 66, 82))
addHoverAnimation(speedTwoButton, Color3.fromRGB(38, 43, 54), Color3.fromRGB(58, 66, 82))
addHoverAnimation(gravityButton, Color3.fromRGB(38, 43, 54), Color3.fromRGB(58, 66, 82))

local function makeConfigBox(name, placeholder, text, position)
    local box = Instance.new("TextBox")
    box.Name = name
    box.PlaceholderText = placeholder
    box.Text = text
    box.Size = UDim2.new(0, 137, 0, 26)
    box.Position = position
    box.BackgroundColor3 = Color3.fromRGB(25, 29, 37)
    box.TextColor3 = Color3.fromRGB(235, 240, 250)
    box.PlaceholderColor3 = Color3.fromRGB(125, 135, 155)
    box.Font = Enum.Font.Gotham
    box.TextSize = 11
    box.ClearTextOnFocus = false
    box.BorderSizePixel = 0
    box.Parent = panel
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 7)
    return box
end

local speedOneBox = makeConfigBox("SpeedOneConfig", "Speed 1 value", tostring(SETTINGS.speedOne), UDim2.new(0, 12, 0, 94))
local speedTwoBox = makeConfigBox("SpeedTwoConfig", "Speed 2 value", tostring(SETTINGS.speedTwo), UDim2.new(0, 171, 0, 94))
local gravityBox = makeConfigBox("GravityConfig", "Gravity value", tostring(SETTINGS.gravity), UDim2.new(0, 12, 0, 158))

local base = Instance.new("Frame")
base.Name = "JoystickBase"
base.Size = UDim2.fromOffset(170, 170)
base.Position = UDim2.new(0, 26, 1, -205)
base.BackgroundColor3 = Color3.fromRGB(24, 24, 28)
base.BackgroundTransparency = 0.48
base.BorderSizePixel = 0
base.Visible = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
base.Parent = gui
Instance.new("UICorner", base).CornerRadius = UDim.new(1, 0)

local baseGlow = Instance.new("UIStroke")
baseGlow.Color = Color3.fromRGB(100, 110, 140)
baseGlow.Thickness = 1
baseGlow.Transparency = 0.25
baseGlow.Parent = base

local knob = Instance.new("Frame")
knob.Name = "Knob"
knob.AnchorPoint = Vector2.new(0.5, 0.5)
knob.Size = UDim2.fromOffset(68, 68)
knob.Position = UDim2.new(0.5, 0, 0.5, 0)
knob.BackgroundColor3 = Color3.fromRGB(230, 230, 230)
knob.BackgroundTransparency = 0.15
knob.BorderSizePixel = 0
knob.Parent = base
Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

local function resetKnob()
    knob.Position = UDim2.new(0.5, 0, 0.5, 0)
    state.touchDir = Vector3.zero
end

local function setGuiVisible(visible)
    if visible then
        panel.Visible = true
        panel.Position = PANEL_HIDDEN_POSITION
        base.Visible = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
        openButton.Visible = false
        TweenService:Create(panel, PANEL_TWEEN, {Position = PANEL_POSITION}):Play()
    else
        base.Visible = false
        openButton.Visible = true
        state.activeTouch = nil
        resetKnob()
        local hideTween = TweenService:Create(panel, PANEL_TWEEN, {Position = PANEL_HIDDEN_POSITION})
        hideTween.Completed:Connect(function()
            if openButton.Visible then
                panel.Visible = false
            end
        end)
        hideTween:Play()
    end
end

local function hideGui()
    setGuiVisible(false)
end

minimizeButton.MouseButton1Click:Connect(hideGui)
closeButton.MouseButton1Click:Connect(hideGui)
openButton.MouseButton1Click:Connect(function()
    setGuiVisible(true)
end)

local function updateTouchDirection(inputPosition)
    local center = base.AbsolutePosition + (base.AbsoluteSize / 2)
    local delta = Vector2.new(inputPosition.X - center.X, inputPosition.Y - center.Y)
    local maxRadius = SETTINGS.maxJoystickRadius

    if delta.Magnitude > maxRadius then
        delta = delta.Unit * maxRadius
    end

    knob.Position = UDim2.new(0.5, delta.X, 0.5, delta.Y)

    if delta.Magnitude > 6 then
        state.touchDir = Vector3.new(delta.X, 0, delta.Y) / maxRadius
    else
        state.touchDir = Vector3.zero
    end
end

local function setEnabled(enabled)
    state.enabled = enabled
    if enabled then
        workspace.Gravity = SETTINGS.gravity
        buildClone()
    else
        removeClone()
        workspace.Gravity = state.originalGravity
    end
    activateButton.BackgroundColor3 = enabled and Color3.fromRGB(71, 166, 255) or Color3.fromRGB(55, 60, 70)
end

local function refreshControls()
    speedOneButton.Text = "Speed 1: " .. tostring(SETTINGS.speedOne)
    speedTwoButton.Text = "Speed 2: " .. tostring(SETTINGS.speedTwo)
    gravityButton.Text = "Gravity: " .. tostring(SETTINGS.gravity)
    infiniteJumpButton.Text = state.infiniteJump and "InfJump: ON" or "InfJump: OFF"
    infiniteJumpButton.BackgroundColor3 = state.infiniteJump and Color3.fromRGB(45, 155, 110) or Color3.fromRGB(38, 43, 54)
end

speedOneButton.MouseButton1Click:Connect(function()
    state.speedMode = 1
    applyActiveSpeed()
    refreshControls()
end)

speedTwoButton.MouseButton1Click:Connect(function()
    state.speedMode = 2
    applyActiveSpeed()
    refreshControls()
end)

gravityButton.MouseButton1Click:Connect(function()
    setGravity(gravityBox.Text)
    gravityBox.Text = tostring(SETTINGS.gravity)
    refreshControls()
end)

infiniteJumpButton.MouseButton1Click:Connect(function()
    state.infiniteJump = not state.infiniteJump
    refreshControls()
end)

speedOneBox.FocusLost:Connect(function()
    local value = tonumber(speedOneBox.Text)
    if value then
        SETTINGS.speedOne = math.clamp(value, 1, 250)
        speedOneBox.Text = tostring(SETTINGS.speedOne)
        if state.speedMode == 1 then
            applyActiveSpeed()
        end
    else
        speedOneBox.Text = tostring(SETTINGS.speedOne)
    end
    refreshControls()
end)

speedTwoBox.FocusLost:Connect(function()
    local value = tonumber(speedTwoBox.Text)
    if value then
        SETTINGS.speedTwo = math.clamp(value, 1, 250)
        speedTwoBox.Text = tostring(SETTINGS.speedTwo)
        if state.speedMode == 2 then
            applyActiveSpeed()
        end
    else
        speedTwoBox.Text = tostring(SETTINGS.speedTwo)
    end
    refreshControls()
end)

gravityBox.FocusLost:Connect(function()
    setGravity(gravityBox.Text)
    gravityBox.Text = tostring(SETTINGS.gravity)
    refreshControls()
end)

refreshControls()

task.defer(function()
    panel.Visible = true
    TweenService:Create(panel, PANEL_TWEEN, {Position = PANEL_POSITION}):Play()
end)

activateButton.MouseButton1Click:Connect(function()
    setEnabled(not state.enabled)
end)

base.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch and state.enabled then
        state.activeTouch = input
        updateTouchDirection(input.Position)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == state.activeTouch and state.enabled then
        updateTouchDirection(input.Position)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input == state.activeTouch then
        state.activeTouch = nil
        resetKnob()
    end
end)

local pressedKeys = {}

local function updateKeyboardDirection()
    local direction = Vector3.zero
    if pressedKeys.I then
        direction += Vector3.new(0, 0, -1)
    end
    if pressedKeys.K then
        direction += Vector3.new(0, 0, 1)
    end
    if pressedKeys.J then
        direction += Vector3.new(-1, 0, 0)
    end
    if pressedKeys.L then
        direction += Vector3.new(1, 0, 0)
    end
    state.keyboardDir = direction
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then
        return
    end

    if input.KeyCode == Enum.KeyCode.I then
        pressedKeys.I = true
    elseif input.KeyCode == Enum.KeyCode.K then
        pressedKeys.K = true
    elseif input.KeyCode == Enum.KeyCode.J then
        pressedKeys.J = true
    elseif input.KeyCode == Enum.KeyCode.L then
        pressedKeys.L = true
    end

    updateKeyboardDirection()
end)

UserInputService.JumpRequest:Connect(function()
    if not state.infiniteJump or not state.enabled then
        return
    end

    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.I then
        pressedKeys.I = nil
    elseif input.KeyCode == Enum.KeyCode.K then
        pressedKeys.K = nil
    elseif input.KeyCode == Enum.KeyCode.J then
        pressedKeys.J = nil
    elseif input.KeyCode == Enum.KeyCode.L then
        pressedKeys.L = nil
    end

    updateKeyboardDirection()
end)

RunService.Heartbeat:Connect(function()
    if not state.enabled then
        return
    end

    local clone = state.clone
    if not clone then
        return
    end

    local root = getCharacterRoot(clone)
    local humanoid = clone:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 then
        return
    end

    local moveDir = getMoveDirection()
    if moveDir.Magnitude > 0.1 then
        local camera = workspace.CurrentCamera
        if camera and camera.CFrame then
            local look = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
            local right = Vector3.new(camera.CFrame.RightVector.X, 0, camera.CFrame.RightVector.Z)

            if look.Magnitude > 0 then
                look = look.Unit
            end
            if right.Magnitude > 0 then
                right = right.Unit
            end

            local worldDir = (look * -moveDir.Z + right * moveDir.X)
            if worldDir.Magnitude > 0 then
                worldDir = worldDir.Unit
            end

            humanoid:MoveTo(root.Position + worldDir * SETTINGS.moveDistance)
            return
        end
    end

    humanoid:MoveTo(root.Position)
end)

player.CharacterAdded:Connect(function()
    task.wait(0.2)
    buildClone()
end)

if player.Character then
    task.defer(buildClone)
end
