-- LocalScript in StarterPlayerScripts

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

if _G.ReqiumZCloneController then
    return
end
_G.ReqiumZCloneController = true

local SETTINGS = {
    speed = 40,
    moveDistance = 8,
    maxJoystickRadius = 55,
}

local state = {
    clone = nil,
    keyboardDir = Vector3.zero,
    touchDir = Vector3.zero,
    activeTouch = nil,
    enabled = true,
}

local function destroyIfExists(instance)
    if instance and instance.Parent then
        instance:Destroy()
    end
end

local function getMoveDirection()
    return state.touchDir + state.keyboardDir
end

local function getCharacterRoot(character)
    if not character then
        return nil
    end
    return character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
end

local function buildClone()
    if not state.enabled then
        return
    end

    local character = player.Character
    if not character then
        return
    end

    local root = getCharacterRoot(character)
    if not root then
        return
    end

    local humanoid = character:WaitForChild("Humanoid")
    if state.clone and state.clone.Parent then
        state.clone:Destroy()
    end

    local clone = character:Clone()
    clone.Name = "ReqiumZ_Clone"

    for _, descendant in ipairs(clone:GetDescendants()) do
        if descendant:IsA("Script") or descendant:IsA("LocalScript") or descendant:IsA("ModuleScript") then
            descendant:Destroy()
        elseif descendant:IsA("BasePart") then
            descendant.Anchored = false
            descendant.CanCollide = false
            descendant.Massless = true
            descendant.Transparency = math.max(descendant.Transparency, 0.2)
        end
    end

    local cloneHumanoid = clone:FindFirstChildOfClass("Humanoid")
    if cloneHumanoid then
        cloneHumanoid.WalkSpeed = SETTINGS.speed
        cloneHumanoid.JumpPower = 0
        cloneHumanoid.JumpHeight = 0
        cloneHumanoid.AutoRotate = true
        cloneHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    end

    clone:PivotTo(root.CFrame * CFrame.new(4, 0, 0))
    clone.Parent = workspace
    state.clone = clone
end

local function removeClone()
    if state.clone and state.clone.Parent then
        state.clone:Destroy()
    end
    state.clone = nil
end

local existingGui = playerGui:FindFirstChild("ReqiumZ v1")
if existingGui then
    destroyIfExists(existingGui)
end

local gui = Instance.new("ScreenGui")
gui.Name = "ReqiumZ v1"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 100
gui.Parent = playerGui

local panel = Instance.new("Frame")
panel.Name = "Panel"
panel.Size = UDim2.new(0, 360, 0, 96)
panel.Position = UDim2.new(0.5, -180, 0, 18)
panel.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
panel.BackgroundTransparency = 0.08
panel.BorderSizePixel = 0
panel.Parent = gui
Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 18)

local panelGradient = Instance.new("UIGradient")
panelGradient.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(22, 25, 32)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(11, 13, 18)),
})
panelGradient.Rotation = 90
panelGradient.Parent = panel

local title = Instance.new("TextLabel")
title.Name = "Title"
title.Size = UDim2.new(0, 210, 0, 28)
title.Position = UDim2.new(0, 18, 0, 22)
title.BackgroundTransparency = 1
title.Text = "ReqiumZ v1"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.Font = Enum.Font.GothamBold
title.TextSize = 20
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = panel

local subtitle = Instance.new("TextLabel")
subtitle.Name = "Subtitle"
subtitle.Size = UDim2.new(0, 210, 0, 18)
subtitle.Position = UDim2.new(0, 18, 0, 52)
subtitle.BackgroundTransparency = 1
subtitle.Text = "clone control"
subtitle.TextColor3 = Color3.fromRGB(150, 165, 200)
subtitle.Font = Enum.Font.Gotham
subtitle.TextSize = 12
subtitle.TextXAlignment = Enum.TextXAlignment.Left
subtitle.Parent = panel

local activateButton = Instance.new("TextButton")
activateButton.Name = "Temp"
activateButton.Text = "Temp"
activateButton.Size = UDim2.new(0, 118, 0, 42)
activateButton.Position = UDim2.new(1, -136, 0.5, -21)
activateButton.BackgroundColor3 = Color3.fromRGB(71, 166, 255)
activateButton.TextColor3 = Color3.fromRGB(255, 255, 255)
activateButton.Font = Enum.Font.GothamBold
activateButton.TextSize = 18
activateButton.AutoButtonColor = false
activateButton.BorderSizePixel = 0
activateButton.Parent = panel
Instance.new("UICorner", activateButton).CornerRadius = UDim.new(0, 12)

local buttonGlow = Instance.new("UIStroke")
buttonGlow.Color = Color3.fromRGB(140, 210, 255)
buttonGlow.Thickness = 1.2
buttonGlow.Transparency = 0.2
buttonGlow.Parent = activateButton

local base = Instance.new("Frame")
base.Name = "JoystickBase"
base.Size = UDim2.fromOffset(170, 170)
base.Position = UDim2.new(0, 26, 1, -205)
base.BackgroundColor3 = Color3.fromRGB(24, 24, 28)
base.BackgroundTransparency = 0.48
base.BorderSizePixel = 0
base.Visible = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
base.Parent = gui
Instance.new("UICorner", base).CornerRadius = UDim.new(1, 0)

local baseGlow = Instance.new("UIStroke")
baseGlow.Color = Color3.fromRGB(100, 110, 140)
baseGlow.Thickness = 1
baseGlow.Transparency = 0.25
baseGlow.Parent = base

local knob = Instance.new("Frame")
knob.Name = "Knob"
knob.AnchorPoint = Vector2.new(0.5, 0.5)
knob.Size = UDim2.fromOffset(68, 68)
knob.Position = UDim2.new(0.5, 0, 0.5, 0)
knob.BackgroundColor3 = Color3.fromRGB(230, 230, 230)
knob.BackgroundTransparency = 0.15
knob.BorderSizePixel = 0
knob.Parent = base
Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

local function resetKnob()
    knob.Position = UDim2.new(0.5, 0, 0.5, 0)
    state.touchDir = Vector3.zero
end

local function updateTouchDirection(inputPosition)
    local center = base.AbsolutePosition + (base.AbsoluteSize / 2)
    local delta = Vector2.new(inputPosition.X - center.X, inputPosition.Y - center.Y)
    local maxRadius = SETTINGS.maxJoystickRadius

    if delta.Magnitude > maxRadius then
        delta = delta.Unit * maxRadius
    end

    knob.Position = UDim2.new(0.5, delta.X, 0.5, delta.Y)

    if delta.Magnitude > 6 then
        state.touchDir = Vector3.new(delta.X, 0, delta.Y) / maxRadius
    else
        state.touchDir = Vector3.zero
    end
end

local function setEnabled(enabled)
    state.enabled = enabled
    if enabled then
        buildClone()
    else
        removeClone()
    end
end

activateButton.MouseButton1Click:Connect(function()
    setEnabled(not state.enabled)
end)

base.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch and state.enabled then
        state.activeTouch = input
        updateTouchDirection(input.Position)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == state.activeTouch and state.enabled then
        updateTouchDirection(input.Position)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input == state.activeTouch then
        state.activeTouch = nil
        resetKnob()
    end
end)

local pressedKeys = {}

local function updateKeyboardDirection()
    local direction = Vector3.zero
    if pressedKeys.I then
        direction += Vector3.new(0, 0, -1)
    end
    if pressedKeys.K then
        direction += Vector3.new(0, 0, 1)
    end
    if pressedKeys.J then
        direction += Vector3.new(-1, 0, 0)
    end
    if pressedKeys.L then
        direction += Vector3.new(1, 0, 0)
    end
    state.keyboardDir = direction
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then
        return
    end

    if input.KeyCode == Enum.KeyCode.I then
        pressedKeys.I = true
    elseif input.KeyCode == Enum.KeyCode.K then
        pressedKeys.K = true
    elseif input.KeyCode == Enum.KeyCode.J then
        pressedKeys.J = true
    elseif input.KeyCode == Enum.KeyCode.L then
        pressedKeys.L = true
    end

    updateKeyboardDirection()
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.I then
        pressedKeys.I = nil
    elseif input.KeyCode == Enum.KeyCode.K then
        pressedKeys.K = nil
    elseif input.KeyCode == Enum.KeyCode.J then
        pressedKeys.J = nil
    elseif input.KeyCode == Enum.KeyCode.L then
        pressedKeys.L = nil
    end

    updateKeyboardDirection()
end)

RunService.Heartbeat:Connect(function()
    if not state.enabled then
        return
    end

    local clone = state.clone
    if not clone then
        return
    end

    local root = getCharacterRoot(clone)
    local humanoid = clone:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 then
        return
    end

    local moveDir = getMoveDirection()
    if moveDir.Magnitude > 0.1 then
        local camera = workspace.CurrentCamera
        if camera and camera.CFrame then
            local look = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
            local right = Vector3.new(camera.CFrame.RightVector.X, 0, camera.CFrame.RightVector.Z)

            if look.Magnitude > 0 then
                look = look.Unit
            end
            if right.Magnitude > 0 then
                right = right.Unit
            end

            local worldDir = (look * -moveDir.Z + right * moveDir.X)
            if worldDir.Magnitude > 0 then
                worldDir = worldDir.Unit
            end

            humanoid:MoveTo(root.Position + worldDir * SETTINGS.moveDistance)
            return
        end
    end

    humanoid:MoveTo(root.Position)
end)

player.CharacterAdded:Connect(function()
    task.wait(0.2)
    buildClone()
end)

if player.Character then
    task.defer(buildClone)
end
